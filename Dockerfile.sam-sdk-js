# The JavaScript SDK with its example programs, as the testnet canaries run
# them: `node build/examples/agent.js [url]` joins as an agent that accepts
# A2A requests, `node build/examples/call.js [peer] <service> <tool|path>
# [args]` calls a service or an agent, and `a2a-agent.js` and `a2a-call.js`
# do the same with the official A2A SDK. The examples import "@sam-mesh/sdk"
# by name and resolve it through the package's own exports, so the image
# keeps the package layout: package.json, dist/, build/examples/ and the
# production node_modules/ plus the two packages the A2A examples need,
# which are development dependencies of the SDK, not dependencies.

# Stage 1: Build
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS builder
WORKDIR /src
COPY sdk/js/package.json sdk/js/package-lock.json sdk/js/.npmrc ./
RUN npm ci --no-fund --no-audit
COPY sdk/js/ ./
RUN npm run build && npm run examples && npm prune --omit=dev --no-fund --no-audit \
    && npm install --no-save --no-fund --no-audit @a2a-js/sdk express

# Stage 2: Final
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370
WORKDIR /app
COPY --from=builder --chown=node:node /src/package.json ./
COPY --from=builder --chown=node:node /src/dist ./dist
COPY --from=builder --chown=node:node /src/build/examples ./build/examples
COPY --from=builder --chown=node:node /src/node_modules ./node_modules
USER node
ENV HOME=/home/node
ENTRYPOINT ["node"]
CMD ["build/examples/agent.js"]
