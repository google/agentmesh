{
  "roles": [
    {
      "name": "mesh:role:node",
      "allowed_services": ["*"],
      "allowed_publish": ["*"],
      "allowed_targets": ["*"],
      "allowed_labels": ["*"]
    },
    {
      "name": "mesh:role:router",
      "allowed_services": ["*"],
      "allowed_targets": ["*"]
    },
    {
      "name": "sandbox",
      "allowed_services": [
        "system://mesh.catalog",
        "mcp://calc",
        "mcp://echo-headers"
      ],
      "allowed_targets": ["*"]
    },
    {
      "name": "ledger",
      "allowed_services": [
        "system://mesh.catalog",
        "mcp://payroll"
      ],
      "allowed_targets": ["*"]
    }
  ],
  "bindings": [
    {
      "role": "sandbox",
      "members": [
        "user:spiffe://agentmesh.local/wasm/demo/epoch/*"
      ]
    },
    {
      "role": "ledger",
      "members": [
        "user:spiffe://agentmesh.local/wasm/ledger/epoch/*"
      ]
    }
  ]
}
