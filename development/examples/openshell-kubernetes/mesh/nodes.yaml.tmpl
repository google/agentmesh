# The mesh beside OpenShell, in one namespace: an edge node that is the
# sandboxes' door to the mesh and the supervisors' token endpoint, an office
# node fronting a calculator, and the calculator. The control plane is either
# agentmesh-one in this cluster (hub.yaml.tmpl) or an agentmesh-one elsewhere,
# such as Cloud Run; CONTROL_PLANE_URL names it.
apiVersion: v1
kind: ConfigMap
metadata:
  name: mesh-config
  namespace: agentmesh
data:
  office.yaml: |
    version: "v1alpha1"
    labels:
      site: office
    services:
      - type: mcp
        name: calc
        description: "calculator MCP server in the office"
        target_url: "http://calc-mcp.agentmesh.svc.cluster.local:7777/mcp"
      - type: mcp
        name: payroll
        description: "an MCP server the sandbox role may not call"
        target_url: "http://calc-mcp.agentmesh.svc.cluster.local:7777/mcp"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: edge-node
  namespace: agentmesh
spec:
  replicas: 1
  selector:
    matchLabels: {app: edge-node}
  template:
    metadata:
      labels: {app: edge-node}
    spec:
      containers:
      - name: agentmesh-node
        image: ${AGENTMESH_NODE_IMAGE}
        args:
        - run
        - --control-plane=${CONTROL_PLANE_URL}
        ${CONTROL_PLANE_INSECURE_ARG}
        - --bootstrap-token-path=/run/agentmesh/join-token
        - --api-token-path=/run/agentmesh/api-token
        - --data-dir=/data
        - --bind-addr=0.0.0.0:8080
        - --control-plane-sync-interval=30s
        - --metrics-addr=0.0.0.0:9090
        ports:
        - {name: http, containerPort: 8080}
        readinessProbe:
          httpGet: {path: /readyz, port: 9090}
          periodSeconds: 2
        volumeMounts:
        - {name: tokens, mountPath: /run/agentmesh, readOnly: true}
        - {name: data, mountPath: /data}
      volumes:
      - name: tokens
        secret: {secretName: agentmesh-tokens, defaultMode: 0444}
      - name: data
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: edge-node
  namespace: agentmesh
spec:
  selector: {app: edge-node}
  ports:
  - {name: http, port: 8080, targetPort: http}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: office-node
  namespace: agentmesh
spec:
  replicas: 1
  selector:
    matchLabels: {app: office-node}
  template:
    metadata:
      labels: {app: office-node}
    spec:
      containers:
      - name: agentmesh-node
        image: ${AGENTMESH_NODE_IMAGE}
        args:
        - run
        - --control-plane=${CONTROL_PLANE_URL}
        ${CONTROL_PLANE_INSECURE_ARG}
        - --bootstrap-token-path=/run/agentmesh/join-token
        - --api-token-path=/run/agentmesh/api-token
        - --data-dir=/data
        - --bind-addr=
        - --config=/etc/agentmesh/office.yaml
        - --control-plane-sync-interval=30s
        - --metrics-addr=0.0.0.0:9090
        readinessProbe:
          httpGet: {path: /readyz, port: 9090}
          periodSeconds: 2
        volumeMounts:
        - {name: config, mountPath: /etc/agentmesh, readOnly: true}
        - {name: tokens, mountPath: /run/agentmesh, readOnly: true}
        - {name: data, mountPath: /data}
      volumes:
      - name: config
        configMap: {name: mesh-config}
      - name: tokens
        secret: {secretName: agentmesh-tokens, defaultMode: 0444}
      - name: data
        emptyDir: {}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: calc-mcp
  namespace: agentmesh
spec:
  replicas: 1
  selector:
    matchLabels: {app: calc-mcp}
  template:
    metadata:
      labels: {app: calc-mcp}
    spec:
      containers:
      - name: calc-mcp
        image: ${CALC_MCP_IMAGE}
        ports:
        - {name: http, containerPort: 7777}
---
apiVersion: v1
kind: Service
metadata:
  name: calc-mcp
  namespace: agentmesh
spec:
  selector: {app: calc-mcp}
  ports:
  - {name: http, port: 7777, targetPort: http}
