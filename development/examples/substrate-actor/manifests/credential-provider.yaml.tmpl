# The Agent Mesh credential provider for Substrate's egress gateway. It is a
# CredentialProvider (pkg/proto/credproviderpb) like the bundled Kubernetes
# Secrets one, deployed the same way: a servicedns pod certificate to serve
# with, and the pod-identity trust bundle to verify the gateway's client
# certificate against. `ate-setup` points the gateway at it with
#   --credential-provider '{"name":"agentmesh","address":"credential-provider.agentmesh.svc:50051"}'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: credential-provider
  namespace: agentmesh
spec:
  replicas: 1
  selector:
    matchLabels: {app: credential-provider}
  template:
    metadata:
      labels: {app: credential-provider}
    spec:
      containers:
      - name: credential-provider
        image: ${CREDENTIAL_PROVIDER_IMAGE}
        args:
        - --listen-address=:50051
        - --http-address=:8080
        - --server-cred-bundle=/run/servicedns.podcert.ate.dev/credential-bundle.pem
        - --client-ca-file=/run/podidentity.podcert.ate.dev/trust-bundle.pem
        - --injector-identity=spiffe://cluster.local/ns/ate-system/sa/atenet-egress
        - --provider-name=agentmesh
        - --node-url=http://edge-node.agentmesh.svc.cluster.local:8080
        # Must equal the control plane's --workload-issuer, verbatim.
        - --issuer=http://credential-provider.agentmesh.svc.cluster.local:8080
        - --audience=agentmesh
        - --cache-ttl=60s
        ports:
        - {name: grpc, containerPort: 50051}
        - {name: http, containerPort: 8080}
        readinessProbe:
          httpGet: {path: /readyz, port: http}
        volumeMounts:
        - {name: servicedns, mountPath: /run/servicedns.podcert.ate.dev, readOnly: true}
        - {name: podidentity, mountPath: /run/podidentity.podcert.ate.dev, readOnly: true}
      volumes:
      - name: servicedns
        projected:
          sources:
          - podCertificate:
              signerName: servicedns.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
      - name: podidentity
        projected:
          sources:
          - clusterTrustBundle:
              signerName: podidentity.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem
---
# Only the egress gateway may reach the gRPC port; the HTTP port serves the
# public discovery document the control plane reads.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: credential-provider
  namespace: agentmesh
spec:
  podSelector:
    matchLabels: {app: credential-provider}
  policyTypes: [Ingress]
  ingress:
  - from:
    - namespaceSelector:
        matchLabels: {kubernetes.io/metadata.name: ate-system}
      podSelector:
        matchLabels: {app: atenet-egress}
    ports:
    - {protocol: TCP, port: 50051}
  - ports:
    - {protocol: TCP, port: 8080}
